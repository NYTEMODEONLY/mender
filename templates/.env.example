# Mender secrets live on the portable drive.
# Run `mender.sh setup` or `mender.cmd setup` to choose your provider.
# DeepSeek direct uses DEEPSEEK_API_KEY.
# OpenRouter uses OPENROUTER_API_KEY.
# Custom OpenAI-compatible providers use MENDER_CUSTOM_API_KEY by default.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MENDER_CUSTOM_API_KEY=
